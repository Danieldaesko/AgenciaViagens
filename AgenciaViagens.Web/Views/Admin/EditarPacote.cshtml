@model AgenciaViagens.Domain.Entities.Pacote

<div class="bo-topo">
    <div>
        <h1>Editar pacote</h1>
        <p>@Model.Nome · @Model.VagasOcupadas de @Model.VagasTotal lugares vendidos</p>
    </div>
</div>

<form asp-action="EditarPacote" method="post" enctype="multipart/form-data" style="max-width:760px">
    <partial name="_FormPacote" model="Model" />

    <button type="submit" class="btn-av btn-av-ocre">Guardar alterações</button>
    <a asp-action="Pacotes" style="margin-left:14px;font-size:.9rem">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}