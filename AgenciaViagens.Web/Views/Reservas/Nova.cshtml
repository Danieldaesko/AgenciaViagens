@model AgenciaViagens.Web.Controllers.NovaReservaVM
@{
    var pacote = (AgenciaViagens.Domain.Entities.Pacote)ViewBag.Pacote;
    var precoBase = pacote.PrecoPromocao ?? pacote.PrecoBase;
    var vagas = pacote.VagasTotal - pacote.VagasOcupadas;
    var dias = (pacote.DataRegresso - pacote.DataPartida).Days;
}

<section class="av-cabecalho">
    <div class="container-av">
        <h1>Reservar</h1>
        <p>@pacote.Nome · @pacote.Origem → @pacote.Destino</p>
    </div>
</section>

<section class="av-seccao">
    <div class="container-av">

        <nav class="av-passos">
            <div class="av-passo ativo"><span>1</span>A viagem</div>
            <div class="av-passo"><span>2</span>Quem viaja</div>
            <div class="av-passo"><span>3</span>Confirmar</div>
        </nav>

        <form asp-action="Nova" method="post" class="av-reserva">
            <input type="hidden" asp-for="PacoteId" />

            <div>
                <div asp-validation-summary="ModelOnly" class="av-aviso av-aviso-erro"></div>

                <div class="av-caixa">
                    <h2>Quantas pessoas viajam?</h2>
                    <p>Restam @vagas lugares nesta partida.</p>

                    <div class="av-campo-form" style="max-width:200px">
                        <label asp-for="NumParticipantes"></label>
                        <select asp-for="NumParticipantes" id="numPessoas">
                            @for (var i = 1; i <= Math.Min(vagas, 10); i++)
                            {
                                <option value="@i">@i @(i == 1 ? "pessoa" : "pessoas")</option>
                            }
                        </select>
                        <span asp-validation-for="NumParticipantes" class="av-erro"></span>
                    </div>
                </div>

                <div class="av-caixa">
                    <h2>Onde quer ficar?</h2>
                    <p>O suplemento é por pessoa e já entra no total.</p>

                    @foreach (var a in AgenciaViagens.Domain.Entities.TipoAlojamento.Todos)
                    {
                        <label class="av-opcao">
                            <input type="radio" asp-for="CodigoAlojamento" value="@a.Codigo"
                                   data-suplemento="@a.SuplementoPorPessoa" />
                            <span class="av-opcao-corpo">
                                <span>
                                    <span class="av-opcao-nome">@a.Nome</span>
                                    <span class="av-opcao-desc">@a.Descricao</span>
                                </span>
                                <span class="av-opcao-preco">
                                    @(a.SuplementoPorPessoa == 0 ? "Incluído" : $"+{a.SuplementoPorPessoa:C0}")
                                </span>
                            </span>
                        </label>
                    }
                </div>

                <div class="av-caixa">
                    <h2>Alguma nota para nós?</h2>
                    <p>Alergias, cadeira de rodas, quartos juntos — diga-nos aqui.</p>
                    <div class="av-campo-form">
                        <textarea asp-for="Observacoes" rows="3"
                                  style="width:100%;padding:11px 13px;border:1px solid var(--linha);border-radius:6px;font-family:var(--ff-corpo);font-size:.95rem"
                                  placeholder="Opcional"></textarea>
                    </div>
                </div>
            </div>

            <aside class="av-painel">
                <div style="font-size:.78rem;color:var(--cinza);font-weight:600;margin-bottom:6px">
                    @pacote.Origem → @pacote.Destino
                </div>
                <div style="font-family:var(--ff-titulo);font-size:1.15rem;font-weight:700;color:var(--carvao);margin-bottom:16px">
                    @pacote.Nome
                </div>

                <div class="av-painel-linhas">
                    <div class="av-painel-linha">
                        <span>Duração</span><span>@dias dias</span>
                    </div>
                    <div class="av-painel-linha">
                        <span>Partida</span><span>@pacote.DataPartida.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="av-painel-linha">
                        <span>Por pessoa</span><span id="precoPessoa">@precoBase.ToString("C0")</span>
                    </div>
                </div>

                <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:18px">
                    <span style="font-size:.9rem;color:var(--cinza)">Total</span>
                    <span id="precoTotal" class="av-painel-preco" style="font-size:1.7rem">@precoBase.ToString("C0")</span>
                </div>

                <button type="submit" class="btn-av btn-av-ocre">Continuar</button>
                <p class="av-painel-nota">Não é cobrado nada agora. Só depois de confirmar.</p>
            </aside>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var base = @precoBase.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var pessoas = document.getElementById('numPessoas');
            var radios = document.querySelectorAll('input[name="CodigoAlojamento"]');
            var elPessoa = document.getElementById('precoPessoa');
            var elTotal = document.getElementById('precoTotal');

            function formatar(v) {
                return new Intl.NumberFormat('pt-PT', {
                    style: 'currency', currency: 'EUR', maximumFractionDigits: 0
                }).format(v);
            }

            function recalcular() {
                var n = parseInt(pessoas.value, 10) || 1;
                var sup = 0;
                radios.forEach(function (r) {
                    if (r.checked) sup = parseFloat(r.dataset.suplemento) || 0;
                });
                var porPessoa = base + sup;
                elPessoa.textContent = formatar(porPessoa);
                elTotal.textContent = formatar(porPessoa * n);
            }

            pessoas.addEventListener('change', recalcular);
            radios.forEach(function (r) { r.addEventListener('change', recalcular); });
            recalcular();
        })();
    </script>
}