@model AgenciaViagens.Web.Controllers.RecuperarVM

<div class="av-form-pagina">
    <div class="av-form-caixa">
        <h1>Recuperar acesso</h1>
        <p>Indique o email da conta. Enviamos-lhe um link para definir nova palavra-passe.</p>

        <form asp-action="RecuperarPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="av-erro-caixa"></div>

            <div class="av-campo-form">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" placeholder="nome@exemplo.pt" />
                <span asp-validation-for="Email" class="av-erro"></span>
            </div>

            <button type="submit" class="btn-av btn-av-ocre">Enviar link</button>
        </form>

        <div class="av-form-rodape">
            Lembrou-se? <a asp-action="Login">Entrar</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
