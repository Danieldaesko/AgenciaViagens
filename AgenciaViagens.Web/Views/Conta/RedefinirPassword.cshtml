@model AgenciaViagens.Web.Controllers.RedefinirVM

<div class="av-form-pagina">
    <div class="av-form-caixa">
        <h1>Nova palavra-passe</h1>
        <p>Escolha uma palavra-passe com pelo menos 8 caracteres.</p>

        <form asp-action="RedefinirPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="av-erro-caixa"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <div class="av-campo-form">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" />
                <span asp-validation-for="Password" class="av-erro"></span>
            </div>

            <div class="av-campo-form">
                <label asp-for="ConfirmarPassword"></label>
                <input asp-for="ConfirmarPassword" type="password" />
                <span asp-validation-for="ConfirmarPassword" class="av-erro"></span>
            </div>

            <button type="submit" class="btn-av btn-av-ocre">Guardar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}