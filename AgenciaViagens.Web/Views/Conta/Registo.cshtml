@model AgenciaViagens.Web.Controllers.RegistoVM

<div class="av-form-pagina">
    <div class="av-form-caixa">
        <h1>Criar conta</h1>
        <p>Guarde as suas reservas e acompanhe os itinerários.</p>

        <form asp-action="Registo" method="post">
            <div asp-validation-summary="ModelOnly" class="av-erro-caixa"></div>

            <div class="av-campo-form">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" placeholder="Como se chama" />
                <span asp-validation-for="Nome" class="av-erro"></span>
            </div>

            <div class="av-campo-form">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" placeholder="nome@exemplo.pt" />
                <span asp-validation-for="Email" class="av-erro"></span>
            </div>

            <div class="av-campo-duplo">
                <div class="av-campo-form">
                    <label asp-for="NIF">NIF</label>
                    <input asp-for="NIF" placeholder="Opcional" />
                </div>
                <div class="av-campo-form">
                    <label asp-for="Telefone">Telemóvel</label>
                    <input asp-for="Telefone" placeholder="Opcional" />
                </div>
            </div>

            <div class="av-campo-form">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" placeholder="Pelo menos 8 caracteres" />
                <span asp-validation-for="Password" class="av-erro"></span>
            </div>

            <div class="av-campo-form">
                <label asp-for="ConfirmarPassword"></label>
                <input asp-for="ConfirmarPassword" type="password" />
                <span asp-validation-for="ConfirmarPassword" class="av-erro"></span>
            </div>

            <button type="submit" class="btn-av btn-av-ocre">Criar conta</button>
        </form>

        <div class="av-form-rodape">
            Já tem conta? <a asp-action="Login">Entrar</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
