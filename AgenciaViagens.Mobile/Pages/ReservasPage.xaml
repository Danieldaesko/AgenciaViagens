<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AgenciaViagens.Mobile.Models"
             x:Class="AgenciaViagens.Mobile.Pages.ReservasPage"
             Title="Reservas"
             BackgroundColor="{StaticResource Pedra}">

    <RefreshView IsRefreshing="{Binding Ocupado}" Command="{Binding CarregarCommand}">
        <CollectionView ItemsSource="{Binding Reservas}" Margin="16,12">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30" Spacing="8" VerticalOptions="Center">
                    <Label Text="Sem reservas" FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource Violeta}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="As suas reservas aparecem aqui assim que reservar uma viagem."
                           FontSize="13" TextColor="{StaticResource Cinza}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ReservaModel">
                    <Border BackgroundColor="White" StrokeThickness="0"
                            Margin="0,0,0,12" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Referencia}" FontSize="12"
                                       TextColor="{StaticResource Cinza}" />
                                <Label Grid.Column="1" Text="{Binding Estado}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{Binding CorEstado}" />
                            </Grid>

                            <Label Text="{Binding Pacote.Nome}" FontSize="16"
                                   FontAttributes="Bold" TextColor="{StaticResource Carvao}" />
                            <Label Text="{Binding Pacote.Percurso}" FontSize="12"
                                   TextColor="{StaticResource Cinza}" />

                            <BoxView HeightRequest="1" Color="{StaticResource Linha}" Margin="0,6" />

                            <Grid ColumnDefinitions="*,*">
                                <VerticalStackLayout>
                                    <Label Text="{Binding ResumoPessoas}" FontSize="12"
                                           TextColor="{StaticResource Cinza}" />
                                    <Label Text="{Binding TotalFormatado}" FontSize="18"
                                           FontAttributes="Bold" TextColor="{StaticResource Violeta}" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1" Text="Cancelar"
                                        FontSize="13" HeightRequest="38" CornerRadius="19"
                                        BackgroundColor="Transparent"
                                        TextColor="#C0392B"
                                        BorderColor="#C0392B" BorderWidth="1"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelarCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>